{
  "name": "@mogos/starlux",
  "version": "0.1.0",
  "description": "Portable living physics and a wake-on-interaction frame clock",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" },
    "./light": { "types": "./dist/src/light/index.d.ts", "default": "./dist/src/light/index.js" },
    "./lux": { "types": "./dist/src/lux.d.ts", "default": "./dist/src/lux.js" },
    "./physics": { "types": "./dist/src/physics.d.ts", "default": "./dist/src/physics.js" },
    "./sensory": { "types": "./dist/ss/sensory.ss.d.ts", "default": "./dist/ss/sensory.ss.js" },
    "./living-state": { "types": "./dist/ss/living-state.ss.d.ts", "default": "./dist/ss/living-state.ss.js" },
    "./voice": { "types": "./dist/src/voice.d.ts", "default": "./dist/src/voice.js" },
    "./dom": { "types": "./dist/src/dom/controller.d.ts", "default": "./dist/src/dom/controller.js" },
    "./c": { "types": "./c/index.d.ts", "default": "./c/index.js" },
    "./magnetic-tiling": { "types": "./dist/src/magnetic-tiling.d.ts", "default": "./dist/src/magnetic-tiling.js" },
    "./dom/magnetic": { "types": "./dist/src/dom/magnetic-controller.d.ts", "default": "./dist/src/dom/magnetic-controller.js" },
    "./wasm/magnetic": { "types": "./c/magnetic-wasm.d.ts", "default": "./c/magnetic-wasm.js" }
  },
  "imports": { "#starlux-magnetic-wasm": "./c/magnetic-wasm.js" },
  "files": ["dist", "ss", "c", "FLOORS.jsonl"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "./c/build-wasm.sh dist/wasm/magnetic",
    "build:wasm:light": "./c/light/build-wasm.sh dist/wasm/light",
    "prepack": "npm run build && npm run build:wasm && npm run build:wasm:light",
    "test": "./gate.sh"
  }
}
